{"title":"Spring Boot - Gestion Projets (4SSA16 Akrem Jouini)","uid":"spring-gp","schemaVersion":39,"refresh":"10s","time":{"from":"now-30m","to":"now"},
"panels":[
{"type":"stat","title":"Backend UP (1 = OK)","gridPos":{"x":0,"y":0,"w":6,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"up{job=\"spring-backend\"}","refId":"A"}]},
{"type":"timeseries","title":"Requetes HTTP par seconde","gridPos":{"x":6,"y":0,"w":18,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(http_server_requests_seconds_count[1m])) by (uri)","legendFormat":"{{uri}}","refId":"A"}]},
{"type":"timeseries","title":"Memoire JVM (heap)","gridPos":{"x":0,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"bytes"}},"targets":[{"expr":"sum(jvm_memory_used_bytes{area=\"heap\"})","refId":"A"}]},
{"type":"timeseries","title":"CPU du process","gridPos":{"x":12,"y":8,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"fieldConfig":{"defaults":{"unit":"percentunit"}},"targets":[{"expr":"process_cpu_usage","refId":"A"}]}
]}
